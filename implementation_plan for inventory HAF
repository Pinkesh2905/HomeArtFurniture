### Phase 2: Data Models

#### [NEW] [models.py](file:///c:/Projects/HomeArtFurniture/inventory/models.py)

```python
# ── Enums ──
class MaterialCategory(models.TextChoices):
    WOOD        = 'wood',        'Wood / Timber'
    FABRIC      = 'fabric',      'Fabric / Upholstery'
    HARDWARE    = 'hardware',    'Hardware (Screws, Nails, Hinges)'
    PAINT       = 'paint',       'Paint / Polish / Finish'
    ADHESIVE    = 'adhesive',    'Adhesive / Glue'
    FOAM        = 'foam',        'Foam / Cushion'
    GLASS       = 'glass',       'Glass / Mirror'
    PLYWOOD     = 'plywood',     'Plywood / MDF / Particle Board'
    METAL       = 'metal',       'Metal (Rods, Pipes, Frames)'
    OTHER       = 'other',       'Other'

class UnitOfMeasure(models.TextChoices):
    PIECES      = 'pcs',     'Pieces'
    KG          = 'kg',      'Kilograms'
    METERS      = 'm',       'Meters'
    SQ_FT       = 'sqft',   'Square Feet'
    SQ_M        = 'sqm',    'Square Meters'
    LITERS      = 'l',       'Liters'
    SHEETS      = 'sheets',  'Sheets'
    CUBIC_FT    = 'cuft',   'Cubic Feet'

class TransactionType(models.TextChoices):
    STOCK_IN    = 'in',   'Stock In'
    STOCK_OUT   = 'out',  'Stock Out'
    ADJUSTMENT  = 'adj',  'Adjustment'
    DAMAGED     = 'dmg',  'Damaged / Wastage'

# ── Models ──

class Supplier(models.Model):
    name          = CharField(max_length=200)
    contact_person = CharField(max_length=150, blank=True)
    phone         = CharField(max_length=15, db_index=True)
    alt_phone     = CharField(max_length=15, blank=True)
    email         = EmailField(blank=True)
    address       = TextField(blank=True)
    city          = CharField(max_length=100, blank=True)
    gst_number    = CharField(max_length=20, blank=True)
    notes         = TextField(blank=True)
    is_active     = BooleanField(default=True)
    created_at    = DateTimeField(auto_now_add=True)
    updated_at    = DateTimeField(auto_now=True)

class Material(models.Model):
    name          = CharField(max_length=200)
    sku           = CharField(max_length=50, unique=True, blank=True)  # auto-generated
    category      = CharField(choices=MaterialCategory.choices)
    unit          = CharField(choices=UnitOfMeasure.choices)
    current_stock = DecimalField(max_digits=12, decimal_places=2, default=0)
    min_stock     = DecimalField(max_digits=12, decimal_places=2, default=0)  # low-stock alert threshold
    cost_per_unit = DecimalField(max_digits=10, decimal_places=2, default=0)
    supplier      = ForeignKey(Supplier, null=True, blank=True, on_delete=SET_NULL)
    location      = CharField(max_length=100, blank=True)  # warehouse shelf/zone
    notes         = TextField(blank=True)
    is_active     = BooleanField(default=True)
    created_at    = DateTimeField(auto_now_add=True)
    updated_at    = DateTimeField(auto_now=True)

    @property
    def is_low_stock(self):
        return self.current_stock <= self.min_stock

    @property
    def stock_value(self):
        return self.current_stock * self.cost_per_unit

class StockTransaction(models.Model):
    material       = ForeignKey(Material, on_delete=CASCADE, related_name='transactions')
    transaction_type = CharField(choices=TransactionType.choices)
    quantity       = DecimalField(max_digits=12, decimal_places=2)
    unit_cost      = DecimalField(max_digits=10, decimal_places=2, default=0)
    total_cost     = DecimalField(max_digits=12, decimal_places=2, default=0)
    reference      = CharField(max_length=100, blank=True)  # invoice/PO number
    supplier       = ForeignKey(Supplier, null=True, blank=True, on_delete=SET_NULL)
    notes          = TextField(blank=True)
    date           = DateField(default=timezone.localdate)
    created_at     = DateTimeField(auto_now_add=True)
```

**Key design decisions:**
- `current_stock` is denormalized on `Material` for fast reads; updated via `services.py` inside `@transaction.atomic` when recording stock transactions.
- SKU auto-generated on first save: `HAF-{CATEGORY_PREFIX}-{PK:04d}` (e.g., `HAF-WOOD-0001`).
- `min_stock` enables low-stock alerts on the dashboard.


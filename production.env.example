# Django Production Settings
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,homeartfurniture.store,www.homeartfurniture.store

# Database Connection (Supabase PostgreSQL Connection String)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
